# Knowledge galaxy viewer. NOT enabled — install it when you want it:
#
#   sudo cp /home/ubuntu/Jarvis/galaxy/galaxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now galaxy
#
# It stays bound to 127.0.0.1 as a service exactly as it does by hand; reach it
# with  ssh -N -L 4700:127.0.0.1:4700 jarvis

[Unit]
Description=Knowledge galaxy viewer (loopback only)
Documentation=file:/home/ubuntu/Jarvis/docs/notes.md
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Jarvis/galaxy
ExecStart=/usr/bin/python3 /home/ubuntu/Jarvis/galaxy/server.py
Restart=on-failure
RestartSec=5

# It serves static files out of one directory and needs nothing else. These
# cost nothing and mean a bug in http.server cannot reach the rest of the box.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/Jarvis/galaxy
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
