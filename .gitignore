# Secrets — never commit
.env
*.pem
*.key

# Data
data/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Bridge state
.jarvis_bridge_state.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Caddy/searxng runtime
caddy-data/
searxng/uwsgi.ini

# Local compose overrides (written by scripts/self-improve.sh)
docker-compose.override.yml
docker-compose.override.yml.bak

# Your notes are yours. The folder is tracked so the default mount exists, but
# nothing you write in it is — self-improvement pushes branches from this
# checkout, and a private vault must never ride along.
/notes/*
!/notes/README.md

# Generated by galaxy/build.py — contains excerpts of your notes. Never commit.
galaxy/viewer/graph-data.js

# Holds a live Anthropic API key. Created at 0600 by galaxy/server.py on first
# run; never committed.
galaxy/config.json
