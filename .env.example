# ─────────────────────────────────────────────────────────────────────────────
# Jarvis configuration. Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# Generate the two secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ---- Who you are ------------------------------------------------------------
OWNER_NAME=Michael
TIMEZONE=America/New_York

# ---- Auth (REQUIRED) --------------------------------------------------------
# AUTH_SECRET signs device tokens; rotating it signs out every device at once.
# ACCESS_PASSWORD is what you type once per device. Make it long.
AUTH_SECRET=
ACCESS_PASSWORD=

# ---- LLM: Groq (REQUIRED, free) ---------------------------------------------
# Free key from https://console.groq.com/keys — no card, generous rate limits.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
# Speech-to-text, same key, same free tier. Used only by browsers whose own
# speech engine is missing or poor (Firefox, older iOS).
WHISPER_MODEL=whisper-large-v3-turbo

# ---- Apple Mail + Calendar (free, via app-specific password) -----------------
# 1. Go to https://account.apple.com → Sign-In and Security → App-Specific Passwords
# 2. Generate one, label it "Jarvis"
# 3. Put your Apple ID email and that password below.
# This is NOT your Apple ID password. Revoke it any time from the same page.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# Calendar reuses the values above unless you override them here.
# CALDAV_USERNAME=
# CALDAV_PASSWORD=
# DEFAULT_CALENDAR=Home

# ---- Messages bridge (iMessage — requires a Mac) -----------------------------
# Any random string; set the identical value on the Mac running jarvis_bridge.py.
BRIDGE_TOKEN=

# ---- Web search (free) -------------------------------------------------------
# docker-compose sets SEARXNG_URL automatically. Brave is an optional fallback:
# free tier key at https://api-dashboard.search.brave.com/
# BRAVE_API_KEY=

# ---- Voice identity (optional) ----------------------------------------------
# Voice matching is a FILTER, not a security boundary: it stops other people in
# the room being answered and alerts you when someone tries. A recording of your
# voice will pass it. Your password is what actually protects this server.
# Enrol from the app first, then set this to true. See docs/voice-identity.md
REQUIRE_VOICE_MATCH=false
# 0.78 is near the measured equal-error rate (~5% of you rejected, ~7% of
# others let in). Raise toward 0.85 to be stricter, lower to 0.72 to be smoother.
VOICE_MATCH_THRESHOLD=0.78
VOICE_ALERT_EMAIL=true

# Say this word to start listening, hands-free. Detected in-browser; no audio
# leaves the device for wake detection.
WAKE_WORD=jarvis
REQUIRE_WAKE_WORD=false

# ---- Self-improvement --------------------------------------------------------
# When true, Jarvis can edit its own source on a throwaway git branch and run
# its tests. It never merges or deploys on its own. Leave false until you've
# read docs/autonomy.md.
AUTONOMY_ENABLED=false
AUTONOMY_MAX_ITERATIONS=6

# ---- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
