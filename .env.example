# ─────────────────────────────────────────────────────────────────────────────
# Jarvis configuration. Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# Generate the two secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ---- Who you are ------------------------------------------------------------
OWNER_NAME=Michael
TIMEZONE=America/New_York

# ---- Auth (REQUIRED) --------------------------------------------------------
# AUTH_SECRET signs device tokens; rotating it signs out every device at once.
# ACCESS_PASSWORD is what you type once per device. Make it long.
AUTH_SECRET=
ACCESS_PASSWORD=

# ---- LLM: Groq (REQUIRED, free) ---------------------------------------------
# Free key from https://console.groq.com/keys — no card, generous rate limits.
GROQ_API_KEY=

# More capacity. Each endpoint below is tried in order when the one before it is
# rate limited, so you stop hitting a wall mid-conversation.
#
# Models tried in order. All must be good at tool calling — this assistant sends
# ~29 tool schemas every turn. Check what your key can actually reach with:
#   docker compose exec jarvis python -m jarvis.doctor
GROQ_MODEL_LADDER=llama-3.3-70b-versatile,openai/gpt-oss-120b,moonshotai/kimi-k2-instruct

# Extra Groq keys, comma separated. NOTE: several accounts at one provider to get
# around its limits is usually a breach of that provider's terms — check yours.
# A second *provider* below is both safer and gives more total capacity.
# GROQ_API_KEYS=gsk_first,gsk_second

# Other providers. All free tiers, all OpenAI-compatible, all independent quota.
# This is the recommended way to get more headroom.
#   Cerebras   https://cloud.cerebras.ai      (very fast, generous free tier)
#   OpenRouter https://openrouter.ai/keys     (many :free models)
#   Together   https://api.together.xyz       (free Llama endpoints)
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
#
# Google AI Studio — likely the biggest free upgrade available. The Flash models
# reason better than Llama 3.3 70B and carry ~1M token context, which makes the
# tool-schema budget stop mattering.  https://aistudio.google.com/apikey
# GEMINI_API_KEY=
#
# GitHub Models — frontier GPT-class models, free with a GitHub account. Tight
# rate limits, so best as a last resort for hard questions.
# GITHUB_MODELS_API_KEY=
# MISTRAL_API_KEY=
#
# Which is actually best for you is measurable, not a matter of opinion:
#   docker compose exec jarvis python -m jarvis.benchmark
#
# OmniRoute — a local gateway in front of a large catalogue of providers, run
# here as a sidecar and used as the fallback when the keys above are spent.
# `bash scripts/omniroute.sh` fills all of these in; see docs/omniroute.md.
# COMPOSE_PROFILES=omniroute
# CUSTOM_BASE_URL=http://omniroute:20128/v1
# CUSTOM_MODEL=auto
# CUSTOM_API_KEY=omniroute
# OMNIROUTE_PASSWORD=            dashboard login, over an SSH tunnel to :20128
# OMNIROUTE_JWT_SECRET=          generated
# OMNIROUTE_API_KEY_SECRET=      generated
# OMNIROUTE_WS_BRIDGE_SECRET=    generated
# Speech-to-text, same key, same free tier. Used only by browsers whose own
# speech engine is missing or poor (Firefox, older iOS).
WHISPER_MODEL=whisper-large-v3-turbo

# ---- Apple Mail + Calendar (free, via app-specific password) -----------------
# 1. Go to https://account.apple.com → Sign-In and Security → App-Specific Passwords
# 2. Generate one, label it "Jarvis"
# 3. Put your Apple ID email and that password below.
# This is NOT your Apple ID password. Revoke it any time from the same page.
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=

# Calendar reuses the values above unless you override them here.
# CALDAV_USERNAME=
# CALDAV_PASSWORD=
# DEFAULT_CALENDAR=Home

# ---- Messages bridge (iMessage — requires a Mac) -----------------------------
# Any random string; set the identical value on the Mac running jarvis_bridge.py.
BRIDGE_TOKEN=

# ---- The cloned voice (Fish Audio) -------------------------------------------
# Billed per character, so it is proxied: the browser asks this server to speak
# and never sees a key. Without both values Jarvis uses the browser's own voice
# and says so on screen — he never switches voices silently.
#
# https://fish.audio -> API keys. The voice id is your cloned voice's model id
# (the hex string on the voice's page; the SDK calls it reference_id).
# Check both without spending anything:  docker compose exec jarvis python -m jarvis.doctor
FISH_API_KEY=
FISH_VOICE_ID=
# s2.1-pro-free is Fish's free tier (fair-use limits, no credit needed) and the
# default. s2.1-pro / s2-pro / s1 bill per character from your API credit.
# FISH_MODEL=s2.1-pro-free

# Where this server is reachable from outside. Only used to hand the Mac an
# absolute URL for a clip to play back through its own speakers.
PUBLIC_URL=https://michael-jarvis.duckdns.org

# ---- Mac companion agent (Mail, Calendar, screen, Shortcuts) -----------------
# Shared secret for the agent's outbound socket. Deliberately separate from
# BRIDGE_TOKEN: the two grant different capabilities, and one leaked secret
# should not hand over both.  openssl rand -hex 32
# See mac-agent/README.md.
AGENT_SECRET=

# ---- Web search (free) -------------------------------------------------------
# docker-compose sets SEARXNG_URL automatically. Brave is an optional fallback:
# free tier key at https://api-dashboard.search.brave.com/
# BRAVE_API_KEY=

# ---- Voice identity (optional) ----------------------------------------------
# Voice matching is a FILTER, not a security boundary: it stops other people in
# the room being answered and alerts you when someone tries. A recording of your
# voice will pass it. Your password is what actually protects this server.
# Enrol from the app first, then set this to true. See docs/voice-identity.md
REQUIRE_VOICE_MATCH=false
# 0.78 is near the measured equal-error rate (~5% of you rejected, ~7% of
# others let in). Raise toward 0.85 to be stricter, lower to 0.72 to be smoother.
VOICE_MATCH_THRESHOLD=0.78
VOICE_ALERT_EMAIL=true

# Say this word to start listening, hands-free. Detected in-browser; no audio
# leaves the device for wake detection.
WAKE_WORD=jarvis
REQUIRE_WAKE_WORD=false

# ---- Continuous self-improvement --------------------------------------------
# Watches its own failures, fixes recurring ones, verifies against the tests.
#   off     : nothing runs (default)
#   propose : fix on a branch, run tests, notify you — you merge
#   apply   : merge automatically when tests pass
# Start with 'propose'. The risk of 'apply' isn't bad code — tests catch most of
# that — it's Jarvis breaking itself overnight and taking your email access with
# it. See docs/self-improvement.md
IMPROVE_MODE=off
IMPROVE_INTERVAL_HOURS=12

# ---- Self-improvement --------------------------------------------------------
# When true, Jarvis can edit its own source on a throwaway git branch and run
# its tests. It never merges or deploys on its own. Leave false until you've
# read docs/autonomy.md.
AUTONOMY_ENABLED=false
AUTONOMY_MAX_ITERATIONS=6

# ---- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO

# Real browser reader (opt-in, see docs/browser.md)
# BROWSER_ENABLED=true
